# /etc/napi-factory/server.env — переменные окружения сервера NAPI Factory Test
NAPI_HOST=0.0.0.0
NAPI_PORT=8080
NAPI_DB_PATH=/var/lib/napi-factory/factory.db
NAPI_PROFILE=/opt/napi-factory-test/config/napi-c-rk3308.yaml
NAPI_WEB_DIST=/opt/napi-factory-test/web/dist
# Общий токен агентов (тот же в agent.yaml и firstboot.conf на картах), не короче 16 символов
NAPI_AGENT_TOKEN=CHANGE-ME-long-random-token
# Оператор, создаваемый при первом запуске (пароль потом меняется командой --set-password)
NAPI_ADMIN_USER=admin
NAPI_ADMIN_PASSWORD=CHANGE-ME
# iperf3-серверы для NET-этапа (по одному процессу на слот профиля net.max_parallel)
NAPI_IPERF_ENABLE=1
# Адрес iperf3 для агентов; пусто — адрес, на который агент подключился по WebSocket
NAPI_IPERF_HOST=
# Только для разработки и стенда-симулятора. В production не включать.
NAPI_ALLOW_SIMULATED=0
NAPI_DESTRUCTIVE_OVERRIDE=0
